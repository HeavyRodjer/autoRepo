generator client {
  provider = "prisma-client-js"
}

// Рядок url звідси прибрано, як того вимагає нова версія Prisma
datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  name         String
  transactions Transaction[]
}

model Car {
  id           String        @id @default(uuid())
  name         String
  rented       Boolean       @default(false)
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // "income" або "expense"
  description String?  // Опис транзакції (за що саме)
  currency    String   @default("UAH") // "UAH" або "USD"
  
  carId       String
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}